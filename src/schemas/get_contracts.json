{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "limit": {
      "type": "string",
      "pattern": "^(?:[1-9]|[1-9][0-9]|100)$"
    },
    "page": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "party_key": {
      "$ref": "contract_common.json#/$defs/uuid"
    },
    "client_key": {
      "$ref": "contract_common.json#/$defs/uuid"
    },
    "external_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "oneOf": [
    {
      "required": [
        "party_key"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "client_key"
            ]
          },
          {
            "required": [
              "external_reference"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "client_key",
        "external_reference"
      ],
      "not": {
        "required": [
          "party_key"
        ]
      }
    }
  ],
  "additionalProperties": false
}
