{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "limit": {
      "type": "string",
      "pattern": "^(?:[1-9]|[1-9][0-9]|100)$"
    },
    "offset": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)$"
    },
    "client_key": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "status": {
      "type": "array",
      "items": {
        "enum": [
          "draft",
          "active",
          "terminated"
        ]
      }
    },
    "external_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "additionalProperties": false
}
