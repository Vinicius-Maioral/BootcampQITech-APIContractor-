{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "split": {
      "$ref": "contract_common.json#/$defs/split"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    }
  },
  "required": [
    "split",
    "actor"
  ],
  "additionalProperties": false
}
