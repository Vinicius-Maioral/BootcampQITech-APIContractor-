{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "role": {
      "enum": [
        "tenant",
        "landlord",
        "administrator",
        "provider"
      ]
    },
    "audit": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        }
      },
      "required": [
        "actor"
      ],
      "additionalProperties": false
    },
    "party": {
      "type": "object",
      "properties": {
        "party_key": {
          "$ref": "#/$defs/uuid"
        },
        "role": {
          "$ref": "#/$defs/role"
        }
      },
      "required": [
        "party_key",
        "role"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "purpose_code": {
          "enum": [
            "RENT",
            "OWN",
            "IPTU",
            "CONDO",
            "WATER",
            "ELECTRICITY"
          ]
        },
        "party_key": {
          "$ref": "#/$defs/uuid"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "type": {
          "enum": [
            "percentage",
            "fixed",
            "remainder"
          ]
        },
        "value": {}
      },
      "required": [
        "purpose_code",
        "party_key",
        "role",
        "type"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "percentage"
            },
            "value": {
              "$ref": "#/$defs/percentage"
            }
          },
          "required": [
            "value"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "fixed"
            },
            "value": {
              "$ref": "#/$defs/money"
            }
          },
          "required": [
            "value"
          ]
        },
        {
          "properties": {
            "type": {
              "const": "remainder"
            }
          },
          "not": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "split": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/item"
      },
      "contains": {
        "type": "object",
        "properties": {
          "type": {
            "const": "remainder"
          }
        },
        "required": [
          "type"
        ]
      },
      "minContains": 1,
      "maxContains": 1
    },
    "percentage": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,2})(?:\\.[0-9]{1,4})?$"
    },
    "money": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99999999999999999999
    },
    "rent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99999999999999999999
    }
  }
}
