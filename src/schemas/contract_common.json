{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "role": {
      "enum": [
        "tenant",
        "landlord",
        "administrator",
        "provider"
      ]
    },
    "audit": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        }
      },
      "required": [
        "actor"
      ],
      "additionalProperties": false
    },
    "party": {
      "type": "object",
      "properties": {
        "party_key": {
          "$ref": "#/$defs/uuid"
        },
        "role": {
          "$ref": "#/$defs/role"
        }
      },
      "required": [
        "party_key",
        "role"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "purpose_code": {
          "enum": [
            "RENT",
            "OWN",
            "IPTU",
            "CONDO",
            "WATER",
            "ELECTRICITY"
          ]
        },
        "party_key": {
          "$ref": "#/$defs/uuid"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "allocation_type": {
          "enum": [
            "percentage",
            "fixed",
            "remainder"
          ]
        },
        "percentage": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,2})(?:\\.[0-9]{1,4})?$"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 999.9999,
              "multipleOf": 0.0001
            }
          ]
        },
        "amount_in_cents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999999999999999
        }
      },
      "required": [
        "purpose_code",
        "party_key",
        "role",
        "allocation_type"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "allocation_type": {
              "const": "percentage"
            }
          },
          "required": [
            "percentage"
          ],
          "not": {
            "required": [
              "amount_in_cents"
            ]
          }
        },
        {
          "properties": {
            "allocation_type": {
              "const": "fixed"
            }
          },
          "required": [
            "amount_in_cents"
          ],
          "not": {
            "required": [
              "percentage"
            ]
          }
        },
        {
          "properties": {
            "allocation_type": {
              "const": "remainder"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "percentage"
                ]
              },
              {
                "required": [
                  "amount_in_cents"
                ]
              }
            ]
          }
        }
      ]
    },
    "split": {
      "type": "object",
      "properties": {
        "rent_amount_in_cents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999999999999999999
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/item"
          },
          "contains": {
            "type": "object",
            "properties": {
              "allocation_type": {
                "const": "remainder"
              }
            },
            "required": [
              "allocation_type"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "required": [
        "rent_amount_in_cents",
        "items"
      ],
      "additionalProperties": false
    }
  }
}
